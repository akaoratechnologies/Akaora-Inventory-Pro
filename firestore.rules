rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // No anonymous users, no cross-account access, no unverified accounts.
    function isOwner(userId) {
      return request.auth != null
          && request.auth.uid == userId
          && request.auth.token.email_verified == true;
    }

    function approvedKey(key) {
      return key in [
        "apora_profile",
        "apora_products",
        "apora_invoices",
        "apora_parties",
        "apora_expenses",
        "apora_purchases",
        "apora_moves",
        "apora_settings",
        "apora_staff",
        "apora_attendance",
        "apora_advances",
        "apora_attendanceLogs",
        "apora_salaryPayments",
        "apora_offers",
        "apora_notifications",
        "apora_quotations",
        "apora_quotation_sequence",
        "apora_accounts_v65",
        "apora_coupons_v15"
      ];
    }

    function goodManifest(key) {
      return request.resource.data.keys().hasOnly([
         'key', 'chunks', 'hash', 'version', 'writer', 'updatedAt',
         'clientUpdatedAt', 'deleted'
      ])
      && request.resource.data.keys().hasAll([
         'key', 'chunks', 'hash', 'version', 'writer', 'updatedAt',
         'clientUpdatedAt', 'deleted'
      ])
      && request.resource.data.key == key
      && request.resource.data.chunks is int
      && request.resource.data.chunks >= 1
      && request.resource.data.chunks <= 490
      && request.resource.data.hash is string
      && request.resource.data.hash.matches('^[0-9a-f]{64}$')
      && request.resource.data.version is string
      && request.resource.data.version.size() <= 150
      && request.resource.data.writer is string
      && request.resource.data.writer.size() <= 100
      && request.resource.data.updatedAt is timestamp
      && request.resource.data.clientUpdatedAt is int
      && request.resource.data.deleted is bool;
    }

    function goodChunk() {
      return request.resource.data.keys().hasOnly(['data', 'version', 'index'])
      && request.resource.data.keys().hasAll(['data', 'version', 'index'])
      && request.resource.data.data is string
      && request.resource.data.data.size() <= 260000
      && request.resource.data.version is string
      && request.resource.data.version.size() <= 150
      && request.resource.data.index is int
      && request.resource.data.index >= 0
      && request.resource.data.index < 490;
    }

    // v81/v82 user-owned collection manifests. Existing readable data is preserved.
    match /users/{userId}/akaoraSync/{key} {
      allow get: if isOwner(userId) && approvedKey(key);
      // Collection listeners must enumerate all approved sync documents.
      allow list: if isOwner(userId);
      allow create, update: if isOwner(userId) && approvedKey(key) && goodManifest(key);
      allow delete: if false; // Avoid accidental complete collection loss.
    }

    match /users/{userId}/akaoraSyncChunks/{chunkId} {
      allow get: if isOwner(userId) && chunkId.matches('^(apora_profile|apora_products|apora_invoices|apora_parties|apora_expenses|apora_purchases|apora_moves|apora_settings|apora_staff|apora_attendance|apora_advances|apora_attendanceLogs|apora_salaryPayments|apora_offers|apora_notifications|apora_quotations|apora_quotation_sequence|apora_accounts_v65|apora_coupons_v15)__[0-9]{1,3}$');
      allow list: if false;
      allow create, update: if isOwner(userId) && chunkId.matches('^(apora_profile|apora_products|apora_invoices|apora_parties|apora_expenses|apora_purchases|apora_moves|apora_settings|apora_staff|apora_attendance|apora_advances|apora_attendanceLogs|apora_salaryPayments|apora_offers|apora_notifications|apora_quotations|apora_quotation_sequence|apora_accounts_v65|apora_coupons_v15)__[0-9]{1,3}$') && goodChunk();
      // v81 sync deletes unused trailing chunks after shrinking a collection.
      allow delete: if isOwner(userId) && chunkId.matches('^(apora_profile|apora_products|apora_invoices|apora_parties|apora_expenses|apora_purchases|apora_moves|apora_settings|apora_staff|apora_attendance|apora_advances|apora_attendanceLogs|apora_salaryPayments|apora_offers|apora_notifications|apora_quotations|apora_quotation_sequence|apora_accounts_v65|apora_coupons_v15)__[0-9]{1,3}$');
    }

    // Everything else stays private, including unexpected nesting under /users.
    match /{document=**} { allow read, write: if false; }
  }
}
